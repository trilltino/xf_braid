# Stage 1: Chef - Install build tools with cargo-binstall (FAST)
FROM rust:1.83-slim-bookworm AS chef
WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev curl && rm -rf /var/lib/apt/lists/*
RUN curl -L --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash \
    && cargo binstall cargo-chef cargo-leptos -y --force

# Stage 2: Planner
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Stage 3: Builder
FROM chef AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y curl pkg-config libssl-dev git build-essential \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs && rm -rf /var/lib/apt/lists/*

RUN rustup toolchain install nightly && rustup default nightly && rustup target add wasm32-unknown-unknown

# Install wasm-bindgen-cli at exact version matching frontend/Cargo.toml
RUN cargo install wasm-bindgen-cli --version 0.2.105

COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json

# Install npm dependencies for Tailwind
COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN cd frontend && npm ci

COPY . .

# BUILD ORDER: CSS → Leptos → XFMail WASM
RUN cd frontend && npm run build:css
ENV CARGO_BUILD_JOBS=4
RUN cargo leptos build --release

# Build XFMail egui WASM (optional - only if xfmail dir exists)
RUN cargo binstall trunk -y --force || true
RUN if [ -d "xfmail/frontend-egui" ]; then \
    cd xfmail/frontend-egui && \
    trunk build --release && \
    mkdir -p /app/target/site/xfmail && \
    cp -r dist/* /app/target/site/xfmail/; \
    fi

# Stage 4: Runtime
FROM debian:bookworm-slim AS runtime
WORKDIR /app
RUN apt-get update && apt-get install -y ca-certificates openssl && rm -rf /var/lib/apt/lists/*
RUN useradd -r -s /bin/false appuser
RUN mkdir -p /app/site && chown -R appuser:appuser /app

COPY --from=builder /app/target/release/backend /app/backend
COPY --from=builder /app/target/site /app/site
COPY start_fly.sh /app/start_fly.sh

RUN chmod +x /app/start_fly.sh && chown -R appuser:appuser /app
USER appuser

ENV LEPTOS_SITE_ROOT=site
ENV LEPTOS_SITE_ADDR="0.0.0.0:3000"
ENV RUST_LOG="info"

EXPOSE 3000
CMD ["/app/start_fly.sh"]
