# ============================================
# XF Braid - Unified Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================
# Leptos site uses SQLite
DATABASE_URL=sqlite:./data.db?mode=rwc

# XFMail database (choose one):
# Development (SQLite):
XFMAIL_DATABASE_URL=sqlite:./xfmail/backend/data.db?mode=rwc
# Production (PostgreSQL):
# XFMAIL_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/xfchat

# ============================================
# Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ============================================
# Server Configuration
# ============================================
# Leptos site
HOST=0.0.0.0
PORT=3000
LEPTOS_TAILWIND_VERSION=v3.4.17

# XFMail backend
SERVER_PORT=3001
RUST_LOG=info,xfmail=debug,backend=debug

# ============================================
# Development Settings
# ============================================
# Set to 1 to bypass auth during development (XFMail only)
DEV_AUTH_BYPASS=0
