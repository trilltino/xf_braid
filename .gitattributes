# Tell GitHub to ignore generated and vendored files in language stats
node_modules/** linguist-vendored
frontend/node_modules/** linguist-vendored
xfmail/frontend-egui/dist/** linguist-generated
frontend/public/xfmail/** linguist-generated
*.wasm linguist-generated
*_bg.js linguist-generated
package-lock.json linguist-generated

# Mark primary languages
*.rs linguist-language=Rust
*.toml linguist-language=TOML

# Exclude documentation from stats
references/** linguist-documentation
*.md linguist-documentation
